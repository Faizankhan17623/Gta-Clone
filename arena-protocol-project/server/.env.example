# Copy to .env locally. Never commit real tokens, passwords, or API keys.
# Node 20.12+ loads server/.env; hosting environment variables take precedence.
PORT=3001
HOST=127.0.0.1
NODE_ENV=development
ADMIN_TOKEN=
ADMIN_EMAIL=
DATABASE_URL=

# Recommended for Render free: HTTPS email (outbound SMTP is blocked).
MAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_FROM=

# Alternative for an SMTP-capable host, including a suitably configured EC2 VM.
# MAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# On a public host set HOST=0.0.0.0 and NODE_ENV=production behind HTTPS.
# For a privately signed Postgres certificate provide DATABASE_CA.
